@model IEnumerable<Tienda.AppMVC.Models.Categoria>

@{
    ViewData["Title"] = "Buscar categorias";
}
<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="card-title mb-3">Buscar Categorías</h5>

            <form asp-controller="Categorias" asp-action="Index" method="get">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label fw-bold text-muted small">Nombre</label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-tag text-primary"></i>
                            </span>
                            <input type="text" name="Nombre" class="form-control"
                                   placeholder="Ej: Electrónica..."/>
                        </div>
                    </div>

                    <div class="col-md-5">
                        <label class="form-label fw-bold text-muted small">Descripción</label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-card-text text-primary"></i>
                            </span>
                            <input type="text" name="Descripcion" class="form-control"
                                   placeholder="Buscar en la descripción..."  />
                        </div>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-bold text-muted small">Top registros</label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-list-ol text-primary"></i>
                            </span>
                            <select name="topRegistro" class="form-select">
                                <option value="10" selected>10</option>
                                <option value="50">50</option>
                                <option value="100">100</option>
                                <option value="500">500</option>
                                <option value="1000">1000</option>
                                <option value="5000">5000</option>
                                <option value="@int.MaxValue">Todos</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="row mt-4">
                        <div class="col-12 d-flex justify-content-start align-items-center gap-2">

                            <button type="submit" class="btn btn-primary px-4 shadow-sm fw-bold">
                                <i class="bi bi-search me-2"></i>Buscar
                            </button>

                            <a asp-action="Create" class="btn btn-outline-success px-4 shadow-sm">
                                <i class="bi bi-plus-lg me-2"></i>Añadir Nueva Categoría
                            </a>

                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Descripcion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaCreacion)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Nombre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Descripcion)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.FechaCreacion)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.CategoriaId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.CategoriaId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.CategoriaId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
