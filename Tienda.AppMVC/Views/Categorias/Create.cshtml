@model Categoria

@{
    ViewData["Title"] = "Nueva Categoría";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <div class="d-flex align-items-center">
                        <div class="icon-box bg-primary bg-opacity-10 p-2 rounded-3 me-3">
                            <i class="bi bi-tag-fill text-primary fs-4"></i>
                        </div>
                        <div>
                            <h4 class="mb-0 fw-bold text-dark">Crear Categoría</h4>
                            <p class="text-muted small mb-0">Gestione los grupos de sus productos</p>
                        </div>
                    </div>
                </div>

                <div class="card-body p-5">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 mb-4" role="alert"></div>

                        <div class="row mb-4">
                            <div class="col-md-4">
                                <label asp-for="Nombre" class="form-label fw-bold text-secondary">Nombre de la Categoría</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted">
                                        <i class="bi bi-pencil"></i>
                                    </span>
                                    <input asp-for="Nombre" class="form-control bg-light border-start-0 ps-0 rounded-end-3" placeholder="Ej: Electrónicos" />
                                </div>
                                <span asp-validation-for="Nombre" class="text-danger small"></span>
                            </div>

                            <div class="col-md-8">
                                <label asp-for="Descripcion" class="form-label fw-bold text-secondary">Descripción</label>
                                <textarea asp-for="Descripcion" class="form-control bg-light rounded-3" rows="1" style="min-height: 38px;" placeholder="Breve descripción..."></textarea>
                                <span asp-validation-for="Descripcion" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12 d-flex gap-3 mt-1">
                                <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill border-0 fw-semibold">
                                    <i class="bi bi-arrow-left me-2"></i> Cancelar
                                </a>
                                <button type="submit" class="btn btn-primary px-5 rounded-pill shadow-sm fw-bold">
                                    <i class="bi bi-check2-circle me-2"></i> Guardar Categoría
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>