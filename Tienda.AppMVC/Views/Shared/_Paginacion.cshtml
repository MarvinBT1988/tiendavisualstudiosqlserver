<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
<script>
        $(document).ready(function () {
        $('.jspaginacion').DataTable({
            // Configuración opcional para personalizar el comportamiento
            "pageLength": 10,      // Cuántos registros ver al inicio
            searching: false, // Muestra u oculta el cuadro de búsqueda
            ordering:  false, // Permite o deshabilita el ordenamiento por columnas
           "lengthChange": false,    // Permite al usuario cambiar cuántos registros ve (10, 25, 50...)
            "language": {
                "url": "https://cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json"
            },
            "responsive": true    // Hace que la tabla se vea bien en móviles
        });
    });
</script>